#!/bin/sh
# git credential helper for github.com/chkm8-agent: hands git the token from the macOS Keychain
# (chkm8-ghcr-push) at push time. Nothing is written to ~/.gitconfig or the repo.
# Reads via the chkm8 venv's Python keyring (which created the item, so it's on the item's ACL);
# the `security` CLI isn't on that ACL and blocks on a GUI "allow access?" prompt.
[ "$1" = "get" ] || exit 0
echo "username=chkm8-agent"
echo "password=$("$HOME/chkm8/.venv/bin/python" -c 'import keyring;print(keyring.get_password("chkm8-ghcr-push","chkm8-agent"))')"
